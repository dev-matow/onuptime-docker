# Production environment template for Vigil.
# Copy to your secret manager / host env — do not commit real values.

# --- Required -------------------------------------------------------------

# Postgres 18+; the app, worker and job queue share this database.
DATABASE_URL=postgresql://vigil:CHANGE_ME@db.internal:5432/vigil

# Session/token signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MINIMUM

# Canonical public origin (links in emails, CORS trust, status pages)
APP_URL=https://vigil.yourdomain.com

# --- Optional -------------------------------------------------------------


# Enables real email notifications via Resend. Without a key, notifications
# are written to the logs. EMAIL_FROM must be a domain Resend verifies.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Vigil <alerts@yourdomain.com>

# fatal | error | warn | info | debug | trace   (default: info)
LOG_LEVEL=info

# Leave false in production: monitors may not probe private networks (SSRF)
ALLOW_PRIVATE_MONITOR_TARGETS=false

# Public read-only demo deployment only — see docs/DEMO.md
DEMO_MODE=false
