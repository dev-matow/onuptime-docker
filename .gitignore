# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder template the quick start tells you to copy
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing artifacts
/playwright-report/
/test-results/

# Ad-hoc browser-audit output: captures and accessibility dumps written
# while checking a page by hand. A screenshot worth keeping goes into
# docs/ or landing/assets/ under its own name.
/output/
.playwright-cli/

# build-process notes (not part of the product)
.engineering_state.json

# src/lib is application source, not build output — re-include it
# explicitly so machine-level "lib/" ignore templates can never hide it.
!/src/lib/
docker-compose.override.yml

# Raw benchmark output. A chosen run is copied into the evidence pack;
# ad-hoc runs are noise, and a stale one is worse than none.
bench-results/

# Release evidence is committed, whatever a developer's global ignore
# says. A `*.log` in ~/.gitignore_global silently swallowed these once,
# and evidence that exists only on the machine that produced it is not
# evidence.
!docs/evidence/*.log
